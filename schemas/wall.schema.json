{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wall-whisperers.local/schemas/wall.schema.json",
  "title": "Climbing Wall",
  "description": "Schema for a climbing wall definition and its holds (Beta Engine MVP).",
  "type": "object",
  "additionalProperties": false,
  "required": ["wall_id", "holds"],
  "properties": {
    "wall_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-]{1,64}$",
      "description": "Unique identifier; letters, digits, '-' or '_'."
    },
    "name": { "type": "string" },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1, "maximum": 200 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "holds": {
      "type": "array",
      "items": { "$ref": "#/$defs/hold" }
    }
  },
  "$defs": {
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_id",
        "grid_x",
        "grid_y",
        "hold_type",
        "orientation_deg",
        "size",
        "color",
        "is_start",
        "is_finish"
      ],
      "properties": {
        "hold_id": { "type": "string", "minLength": 1 },
        "grid_x": { "type": "integer", "minimum": 0 },
        "grid_y": { "type": "integer", "minimum": 0, "description": "0 = bottom of wall (climbing convention)." },
        "hold_type": {
          "type": "string",
          "enum": ["jug", "crimp", "sloper", "pinch", "foothold"]
        },
        "orientation_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "0 = up, increases clockwise; indicates the direction of pull/grip."
        },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "color": {
          "type": "string",
          "minLength": 1,
          "description": "Hex code (#RRGGBB) or any free-form color name."
        },
        "is_start": { "type": "boolean" },
        "is_finish": { "type": "boolean" }
      }
    }
  }
}
